# 이 파일을 복사해서 ".env.local" 이라는 이름으로 저장한 뒤, = 뒤에 값을 채우세요.
# 값 찾는 위치: Supabase 대시보드 → Settings(⚙️) → API Keys / Data API

# Project URL (예: https://abcd1234.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) — 구 명칭 anon key. 브라우저 노출 OK
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (sb_secret_...) — 구 명칭 service_role. 절대 공개 금지!
SUPABASE_SERVICE_ROLE_KEY=

# 학생 로그인 쿠키 서명용 랜덤 문자열 (openssl rand -base64 32 등으로 생성)
STUDENT_JWT_SECRET=
